{
  "name": "just-board",
  "version": "0.0.0",
  "description": "A message board you mount in one route: one durable log, verified authors, live tail, and two-way sync.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "just-board": "./dist/cli.mjs",
    "jb": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.node.d.mts",
        "default": "./dist/index.node.mjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./contract": {
      "types": "./dist/contract.d.mts",
      "default": "./dist/contract.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@vercel/oidc": "^3.8.9",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "experimental-a2": "^0.16.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "experimental-a2": "0.16.1"
  }
}
